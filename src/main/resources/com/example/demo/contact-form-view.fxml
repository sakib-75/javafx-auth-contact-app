<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.ContactFormController" style="-fx-background-color: #f5f5f5;">
    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30"
          AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50">
        <Label text="Contact Form" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
            <VBox spacing="8">
                <Label text="Contact Person Name:" style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="nameField" promptText="Enter contact name" style="-fx-font-size: 14px; -fx-pref-width: 300px;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Address (Optional):" style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="addressField" promptText="Enter address" style="-fx-font-size: 14px; -fx-pref-width: 300px;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Mobile:" style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="mobileField" promptText="e.g., 01712345678" style="-fx-font-size: 14px; -fx-pref-width: 300px;"/>
            </VBox>

            <Label fx:id="messageLabel" wrapText="true" style="-fx-font-size: 13px; -fx-wrap-text: true; -fx-max-width: 300px;"/>

            <Button fx:id="submitButton" text="Submit" onAction="#onSubmitButtonClick"
                    style="-fx-font-size: 16px; -fx-pref-width: 300px; -fx-pref-height: 40px; -fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 5;"/>
            <Button fx:id="logoutButton" text="Logout" onAction="#onLogoutButtonClick"
                    style="-fx-font-size: 14px; -fx-pref-width: 300px; -fx-pref-height: 35px; -fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </VBox>
    </VBox>
</AnchorPane>

