<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.LoginController" style="-fx-background-color: #f5f5f5;">
    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="50" AnchorPane.bottomAnchor="50"
          AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50">
        <Label text="Login" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
            <VBox spacing="8">
                <Label text="Email:" style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="emailField" promptText="Enter your email" style="-fx-font-size: 14px; -fx-pref-width: 300px;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Password:" style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="passwordField" promptText="Enter password" style="-fx-font-size: 14px; -fx-pref-width: 300px;"/>
            </VBox>

            <Label fx:id="messageLabel" style="-fx-font-size: 13px; -fx-wrap-text: true; -fx-max-width: 300px;"/>

            <Button fx:id="loginButton" text="Login" onAction="#onLoginButtonClick"
                    style="-fx-font-size: 16px; -fx-pref-width: 300px; -fx-pref-height: 40px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5;"/>
            <Button text="Switch to Registration" onAction="#onSwitchToRegistrationClick"
                    style="-fx-font-size: 14px; -fx-pref-width: 300px; -fx-pref-height: 35px; -fx-background-color: #254345; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </VBox>
    </VBox>
</AnchorPane>

